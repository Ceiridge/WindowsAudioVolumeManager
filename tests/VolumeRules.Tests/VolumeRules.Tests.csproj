<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <Compile Include="../../Audio/VolumeKey.cs" Link="Audio/VolumeKey.cs" />
    <Compile Include="../../Audio/VolumePolicy.cs" Link="Audio/VolumePolicy.cs" />
    <Compile Include="../../Audio/OutputSelectionPolicy.cs" Link="Audio/OutputSelectionPolicy.cs" />
    <Compile Include="../../Audio/CorrectionGate.cs" Link="Audio/CorrectionGate.cs" />
    <Compile Include="../../Persistence/*.cs" Link="Persistence/%(Filename)%(Extension)" />
    <Compile Include="../../Diagnostics/Logger.cs" Link="Diagnostics/Logger.cs" />
  </ItemGroup>
</Project>
