<Window x:Class="WindowsAudioVolumeManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ceiridge's Windows Audio Volume Manager" Height="560" Width="840"
        MinHeight="420" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Device selection -->
		<DockPanel Grid.Row="0" Margin="0,0,0,8">
			<Button DockPanel.Dock="Right" Content="Refresh" Padding="16,4" Margin="8,0,0,0"
			        Command="{Binding RefreshCommand}" />
			<ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
			          DisplayMemberPath="DisplayName" VerticalContentAlignment="Center" />
		</DockPanel>

		<!-- Master + default volume -->
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<GroupBox Grid.Column="0" Header="Master Volume" Margin="0,0,4,0" Padding="8,4">
				<DockPanel>
					<TextBlock DockPanel.Dock="Right" Text="{Binding MasterVolumeText}" Width="44"
					           VerticalAlignment="Center" TextAlignment="Right" />
					<Slider Minimum="0" Maximum="100" SmallChange="1" IsMoveToPointEnabled="True"
					        Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					        VerticalAlignment="Center" AutoToolTipPlacement="TopLeft" />
				</DockPanel>
			</GroupBox>

			<GroupBox Grid.Column="1" Margin="4,0,0,0" Padding="8,4"
			          Header="Default Application Volume (new apps)">
				<DockPanel>
					<TextBlock DockPanel.Dock="Right" Text="{Binding DefaultVolumeText}" Width="44"
					           VerticalAlignment="Center" TextAlignment="Right" />
					<Slider Minimum="0" Maximum="100" SmallChange="1" IsMoveToPointEnabled="True"
					        Value="{Binding DefaultVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					        VerticalAlignment="Center" AutoToolTipPlacement="TopLeft" />
				</DockPanel>
			</GroupBox>
		</Grid>

		<!-- Search -->
		<Grid Grid.Row="2" Margin="0,0,0,8">
			<TextBox x:Name="SearchBox" Padding="4,3"
			         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			         PreviewKeyDown="SearchBox_PreviewKeyDown" />
			<TextBlock Text="Search apps… (Esc to clear)" Foreground="Gray" Margin="8,0,0,0"
			           VerticalAlignment="Center" IsHitTestVisible="False">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</Grid>

		<!-- Sessions -->
		<ListView Grid.Row="3" ItemsSource="{Binding SessionsView}"
		          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListView.ItemContainerStyle>
				<Style TargetType="ListViewItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="Padding" Value="6,4" />
				</Style>
			</ListView.ItemContainerStyle>
			<ListView.GroupStyle>
				<GroupStyle>
					<GroupStyle.HeaderTemplate>
						<DataTemplate>
							<StackPanel Margin="2,6,2,2">
								<TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="Gray" />
								<Separator Margin="0,2,0,0" />
							</StackPanel>
						</DataTemplate>
					</GroupStyle.HeaderTemplate>
				</GroupStyle>
			</ListView.GroupStyle>
			<ListView.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.Style>
							<Style TargetType="Grid">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsActive}" Value="False">
										<Setter Property="Opacity" Value="0.55" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<Grid.ContextMenu>
							<ContextMenu>
								<MenuItem Header="{Binding LastSeenText}" IsEnabled="False" />
								<Separator />
								<MenuItem Header="Remove from saved" Command="{Binding RemoveSavedCommand}" />
							</ContextMenu>
						</Grid.ContextMenu>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="230" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="52" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="🔔" Margin="0,0,6,0" VerticalAlignment="Center">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsSystemSounds}" Value="True">
												<Setter Property="Visibility" Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"
							           TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding LastSeenText}">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsSystemSounds}" Value="True">
												<Setter Property="Foreground" Value="#3E8EE0" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</StackPanel>

						<Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" IsMoveToPointEnabled="True"
						        Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						        VerticalAlignment="Center" Margin="8,0" AutoToolTipPlacement="TopLeft" />

						<TextBlock Grid.Column="2" Text="{Binding VolumeText, Mode=OneWay}"
						           VerticalAlignment="Center" TextAlignment="Right" />

						<CheckBox Grid.Column="3" Content="Saved" Margin="12,0,4,0" VerticalAlignment="Center"
						          IsChecked="{Binding Saved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						          ToolTip="Remember this app's volume and re-apply it whenever the app plays audio" />
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<!-- Settings -->
		<Expander Grid.Row="4" Header="Settings" Margin="0,8,0,0">
			<Grid Margin="8">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="Show window hotkey:" VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBox x:Name="HotkeyBox" Width="180" IsReadOnly="True" IsReadOnlyCaretVisible="False"
					         Text="{Binding Settings.HotkeyDisplay, Mode=OneWay}"
					         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
					         ToolTip="Click here, then press the new key combination (must include Ctrl, Alt or Win)" />
					<TextBlock Text="Click the box and press a key combination" Foreground="Gray"
					           VerticalAlignment="Center" Margin="8,0,0,0" />
				</StackPanel>

				<WrapPanel Grid.Row="1">
					<CheckBox Content="Show tray icon" Margin="0,0,16,0"
					          IsChecked="{Binding Settings.TrayIconEnabled, Mode=TwoWay}" />
					<CheckBox Content="Start with Windows" Margin="0,0,16,0"
					          IsChecked="{Binding Settings.Autostart, Mode=TwoWay}" />
					<CheckBox Content="Start minimized" Margin="0,0,16,0"
					          IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" />
					<CheckBox Content="Follow Windows default device" Margin="0,0,16,0"
					          IsChecked="{Binding Settings.FollowDefaultDevice, Mode=TwoWay}" />
				</WrapPanel>
			</Grid>
		</Expander>

		<!-- Status line -->
		<DockPanel Grid.Row="5" Margin="0,8,0,0">
			<TextBlock DockPanel.Dock="Right" Text="{Binding HotkeyStatusText}" Foreground="Gray" />
			<TextBlock Text="{Binding StatusText}" Foreground="Gray" TextTrimming="CharacterEllipsis" />
		</DockPanel>
	</Grid>
</Window>
